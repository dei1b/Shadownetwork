          "key": "FK",
          "nullable": false
        },
        {
          "name": "status",
          "type": "TEXT",
          "nullable": false
        },
        {
          "name": "latitude",
          "type": "REAL",
          "nullable": true
        },
        {
          "name": "longitude",
          "type": "REAL",
          "nullable": true
        },
        {
          "name": "created_at",
          "type": "TEXT",
          "nullable": false
        },
        {
          "name": "updated_at",
          "type": "TEXT",
          "nullable": true
        },
        {
          "name": "message_hash",
          "type": "TEXT",
          "nullable": true
        },

        {
          "name": "id",
          "type": "TEXT",
          "key": "PK",
          "nullable": false
        },
        {
          "name": "sender_peer_id",
          "type": "TEXT",
          "key": "FK",
          "nullable": false
        },
        {
          "name": "body",
          "type": "TEXT",
          "nullable": false

        {
          "name": "ttl_seconds",
          "type": "INTEGER",
          "nullable": false,
          "default": 86400,
          "check": "ttl_seconds > 0"
        },
        {
          "name": "moderation_status",
          "type": "TEXT",
          "nullable": false,
          "default": "normal",
          "check": "moderation_status IN ('normal', 'spam')"
